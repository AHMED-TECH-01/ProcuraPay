# ==============================================================================
# ProcuraPay AI — Autonomous External API Configuration Template
# ==============================================================================

# 1. AI REASONING & INTENT PARSING (Google Gemini API)
# Developer Portal: https://aistudio.google.com/
# Automatically provisioned in Google AI Studio environment.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# 2. AUTHENTICATION & MULTI-TENANT DATABASE (Supabase)
# Developer Portal: https://supabase.com/dashboard/project/_/settings/api
# Used for Row-Level Security (RLS), Profiles, Organizations, and Session storage.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. PAYMENT PROCESSING (PayPal Developer REST API v2 Sandbox)
# Developer Portal: https://developer.paypal.com/dashboard/applications/sandbox
# Create a REST API app under 'Sandbox' to obtain Client ID & Secret.
# If left blank, the platform operates in Emulated Sandbox Mode with simulated test transactions.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""

# 4. PRODUCT DISCOVERY & B2B CATALOG SEARCH (Channel3 API)
# Developer Portal: https://channel3.io/
# Live commercial catalog search across major B2B distributors.
# If left blank, the platform automatically routes queries to the Curated Verified B2B Catalog.
CHANNEL3_API_KEY=""
CHANNEL3_BASE_URL="https://api.channel3.io/v1"

# 5. TRANSACTIONAL EMAIL DELIVERY (Resend API)
# Developer Portal: https://resend.com/api-keys
# Used for user email verification and payment audit notices.
# If left blank, the platform automatically dispatches emails to the Development Sandbox Logger.
RESEND_API_KEY=""
EMAIL_FROM="ProcuraPay AI <noreply@procurapay.ai>"

# 6. APPLICATION RUNTIME & SELF-REFERENTIAL URL
# Cloud Run or local dev URL for OAuth callbacks and verification links.
APP_URL="http://localhost:3000"
PORT=3000
